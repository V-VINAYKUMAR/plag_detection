#root {
  min-height: 100vh;
}

.app-shell {
  position: relative;
  overflow: hidden;
  background: #09090f;
  color: #f4f4f5;
}

.ambient {
  position: absolute;
  pointer-events: none;
  border-radius: 50%;
  filter: blur(100px);
  opacity: .18;
}

.ambient-one {
  width: 420px;
  height: 420px;
  background: #6d28d9;
  top: 130px;
  left: -250px;
}

.ambient-two {
  width: 480px;
  height: 480px;
  background: #1d4ed8;
  top: 550px;
  right: -300px;
}

.navbar,
.hero,
.detectors-section,
.how-section,
.bottom-cta,
.footer {
  position: relative;
  z-index: 1;
  width: min(1120px, calc(100% - 48px));
  margin-inline: auto;
}

.navbar {
  height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: #f4f4f5;
  text-decoration: none;
  font-size: 20px;
  font-weight: 750;
  letter-spacing: -.7px;
}

.brand-mark,
.bottom-cta-icon {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border: 1px solid rgba(167,139,250,.35);
  border-radius: 12px;
  color: #c4b5fd;
  background: linear-gradient(145deg, rgba(139,92,246,.24), rgba(59,130,246,.1));
}

.brand-highlight {
  color: #a78bfa;
}

.brand-badge {
  padding: 3px 6px;
  border: 1px solid rgba(167,139,250,.35);
  border-radius: 5px;
  color: #c4b5fd;
  font-size: 10px;
  letter-spacing: .4px;
}

.nav-links {
  display: flex;
  gap: 32px;
}

.nav-links a,
.footer-link {
  color: #a1a1aa;
  text-decoration: none;
  font-size: 13px;
  transition: color .2s ease;
}

.nav-links a:hover,
.footer-link:hover {
  color: #c4b5fd;
}

.nav-cta,
.primary-button,
.secondary-button,
.card-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border-radius: 11px;
  cursor: pointer;
  text-decoration: none;
  transition: transform .2s ease, border-color .2s ease, background .2s ease;
}

.nav-cta {
  padding: 11px 15px;
  border: 1px solid rgba(167,139,250,.3);
  color: #e9e5ff;
  background: rgba(139,92,246,.12);
  font-size: 12px;
  font-weight: 650;
}

.nav-cta:hover,
.primary-button:hover,
.secondary-button:hover {
  transform: translateY(-2px);
}

.mobile-menu {
  display: none;
  color: white;
  background: transparent;
  border: 0;
}

.hero {
  padding-top: 86px;
  text-align: center;
}

.hero-pill,
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: #c4b5fd;
  font-size: 11px;
  font-weight: 750;
  letter-spacing: 1.7px;
  text-transform: uppercase;
}

.hero-pill {
  padding: 10px 15px;
  border: 1px solid rgba(167,139,250,.25);
  border-radius: 999px;
  background: rgba(139,92,246,.08);
  font-size: 11px;
  letter-spacing: .2px;
  text-transform: none;
}

.live-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #a78bfa;
  box-shadow: 0 0 12px rgba(167,139,250,.65);
  flex: 0 0 auto;
}

.hero h1 {
  margin: 29px 0 19px;
  font-size: clamp(42px, 7vw, 76px);
  line-height: 1.08;
  letter-spacing: -4px;
  font-weight: 800;
}

.gradient-text {
  background: linear-gradient(100deg, #c4b5fd 5%, #a78bfa 40%, #60a5fa 95%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-description {
  max-width: 610px;
  margin: 0 auto;
  color: #a1a1aa;
  font-size: 15px;
  line-height: 1.9;
}

.hero-actions {
  margin-top: 29px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 13px;
  flex-wrap: wrap;
}

.primary-button {
  min-height: 46px;
  padding: 0 19px;
  border: 1px solid rgba(196,181,253,.45);
  background: linear-gradient(110deg, #7c3aed, #4f46e5);
  color: white;
  box-shadow: 0 8px 30px rgba(109,40,217,.2);
  font-size: 13px;
  font-weight: 700;
}

.secondary-button {
  min-height: 46px;
  padding: 0 17px;
  border: 1px solid rgba(255,255,255,.12);
  color: #d4d4d8;
  background: rgba(255,255,255,.035);
  font-size: 13px;
}

.hero-trust {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12px;
  margin-top: 27px;
  text-align: left;
}

.avatar-stack {
  display: flex;
  padding-left: 4px;
}

.avatar-stack span {
  display: grid;
  place-items: center;
  width: 29px;
  height: 29px;
  margin-left: -4px;
  border: 2px solid #09090f;
  border-radius: 50%;
  color: #ddd6fe;
  background: #292047;
}

.avatar-stack span:nth-child(2) {
  color: #bfdbfe;
  background: #17284b;
}

.avatar-stack span:nth-child(3) {
  color: #fbcfe8;
  background: #4a203f;
}

.hero-trust p {
  margin: 0;
  color: #71717a;
  font-size: 10px;
  line-height: 1.7;
}

.hero-trust strong {
  color: #d4d4d8;
  font-weight: 650;
}

.hero-visual {
  max-width: 860px;
  margin: 58px auto 0;
  overflow: hidden;
  text-align: left;
  border: 1px solid rgba(255,255,255,.13);
  border-radius: 18px;
  background: rgba(15,15,26,.92);
  box-shadow: 0 30px 100px rgba(0,0,0,.4), 0 0 80px rgba(124,58,237,.09);
  animation: rise-in .8s ease both;
}

.preview-topbar {
  display: flex;
  height: 44px;
  align-items: center;
  justify-content: space-between;
  padding: 0 17px;
  border-bottom: 1px solid rgba(255,255,255,.08);
  color: #71717a;
  font-size: 10px;
}

.window-dots {
  display: flex;
  gap: 5px;
}

.window-dots i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #52525b;
}

.window-dots i:first-child { background: #f87171; }
.window-dots i:nth-child(2) { background: #fbbf24; }
.window-dots i:nth-child(3) { background: #4ade80; }

.preview-status,
.preview-analysis .analysis-bottom span,
.analysis-tag {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.preview-status {
  color: #86efac;
}

.preview-status .live-dot {
  width: 6px;
  height: 6px;
  background: #4ade80;
}

.preview-body {
  display: flex;
  min-height: 320px;
}

.preview-sidebar {
  width: 58px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  padding: 18px 0;
  border-right: 1px solid rgba(255,255,255,.07);
  background: rgba(255,255,255,.012);
}

.mini-logo,
.mini-side-item {
  display: grid;
  place-items: center;
  width: 32px;
  height: 32px;
  border-radius: 9px;
}

.mini-logo {
  margin-bottom: 9px;
  color: #c4b5fd;
  background: rgba(139,92,246,.16);
}

.mini-side-item {
  color: #71717a;
}

.mini-side-item.active {
  color: #c4b5fd;
  border: 1px solid rgba(167,139,250,.22);
  background: rgba(139,92,246,.13);
}

.mini-sidebar-bottom {
  margin-top: auto;
  color: #71717a;
}

.preview-content {
  flex: 1;
  min-width: 0;
  padding: 26px;
}

.preview-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.eyebrow {
  font-size: 9px;
  letter-spacing: 1.5px;
}

.preview-heading h3 {
  margin: 8px 0 0;
  font-size: 19px;
  letter-spacing: -.5px;
}

.preview-date {
  padding: 8px 10px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 8px;
  color: #a1a1aa;
  font-size: 10px;
}

.preview-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0,1fr));
  gap: 12px;
  margin-top: 24px;
}

.metric-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
  padding: 14px;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 11px;
  background: rgba(255,255,255,.025);
}

.metric-icon {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  border-radius: 9px;
}

.metric-icon.violet { color: #c4b5fd; background: rgba(139,92,246,.16); }
.metric-icon.blue { color: #93c5fd; background: rgba(59,130,246,.15); }
.metric-icon.pink { color: #f9a8d4; background: rgba(236,72,153,.13); }

.metric-label,
.metric-foot {
  color: #a1a1aa;
  font-size: 10px;
}

.metric-card strong {
  font-size: 25px;
  letter-spacing: -1px;
}

.metric-foot {
  color: #71717a;
  font-size: 9px;
}

.preview-analysis {
  margin-top: 14px;
  padding: 15px;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 11px;
  background: rgba(255,255,255,.02);
}

.analysis-title,
.analysis-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.analysis-title {
  font-size: 11px;
  font-weight: 650;
}

.analysis-tag {
  color: #c4b5fd;
  font-size: 9px;
  font-weight: 500;
}

.analysis-lines {
  display: grid;
  gap: 9px;
  margin: 19px 0;
}

.line {
  display: block;
  height: 6px;
  border-radius: 10px;
  background: linear-gradient(90deg, rgba(167,139,250,.22), rgba(255,255,255,.05));
}

.line.long { width: 86%; }
.line.medium { width: 64%; }
.line.short { width: 43%; }

.analysis-bottom {
  padding-top: 12px;
  border-top: 1px solid rgba(255,255,255,.07);
  color: #71717a;
  font-size: 9px;
}

.ready-pill {
  padding: 5px 8px;
  border: 1px solid rgba(74,222,128,.2);
  border-radius: 6px;
  color: #86efac;
  background: rgba(34,197,94,.07);
}

.detectors-section {
  padding-top: 112px;
  scroll-margin-top: 25px;
}

.section-heading {
  text-align: center;
}

.section-heading h2,
.how-copy h2 {
  margin: 17px 0 12px;
  font-size: clamp(30px, 4vw, 43px);
  line-height: 1.2;
  letter-spacing: -1.8px;
}

.section-heading > p,
.how-copy > p {
  color: #a1a1aa;
  font-size: 13px;
  line-height: 1.8;
}

.detector-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0,1fr));
  gap: 17px;
  margin-top: 39px;
}

.detector-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: 270px;
  padding: 23px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 15px;
  background: linear-gradient(145deg, rgba(255,255,255,.045), rgba(255,255,255,.012));
  transition: transform .25s ease, border-color .25s ease, background .25s ease;
  animation: rise-in .65s ease both;
}

.detector-card::before {
  position: absolute;
  top: -90px;
  right: -90px;
  width: 180px;
  height: 180px;
  border-radius: 50%;
  filter: blur(55px);
  opacity: .12;
  content: "";
  pointer-events: none;
}

.detector-card.violet::before { background: #a78bfa; }
.detector-card.blue::before { background: #60a5fa; }
.detector-card.pink::before { background: #f472b6; }

.detector-card:hover {
  transform: translateY(-5px);
  border-color: rgba(167,139,250,.38);
  background: linear-gradient(145deg, rgba(139,92,246,.09), rgba(255,255,255,.015));
}

.card-top {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
}

.detector-icon {
  display: grid;
  place-items: center;
  width: 47px;
  height: 47px;
  border: 1px solid;
  border-radius: 13px;
}

.detector-icon.violet { color: #c4b5fd; border-color: rgba(167,139,250,.24); background: rgba(139,92,246,.13); }
.detector-icon.blue { color: #93c5fd; border-color: rgba(96,165,250,.24); background: rgba(59,130,246,.12); }
.detector-icon.pink { color: #f9a8d4; border-color: rgba(244,114,182,.24); background: rgba(236,72,153,.1); }

.card-number {
  color: #52525b;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
}

.detector-tag {
  margin-top: 24px;
  color: #a78bfa;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.2px;
  text-transform: uppercase;
}

.detector-card.blue .detector-tag { color: #93c5fd; }
.detector-card.pink .detector-tag { color: #f9a8d4; }

.detector-card h3 {
  margin: 10px 0 8px;
  font-size: 18px;
  letter-spacing: -.4px;
}

.detector-card > p {
  margin: 0;
  color: #a1a1aa;
  font-size: 12px;
  line-height: 1.8;
}

.card-action {
  justify-content: flex-start;
  margin-top: auto;
  padding: 23px 0 0;
  border: 0;
  color: #ddd6fe;
  background: transparent;
  font-size: 11px;
  font-weight: 700;
}

.card-action:hover {
  color: white;
}

.how-section {
  display: grid;
  grid-template-columns: .9fr 1fr;
  align-items: center;
  gap: 80px;
  padding-top: 130px;
  scroll-margin-top: 25px;
}

.how-copy h2 {
  font-size: clamp(31px, 4vw, 42px);
}

.how-copy > p {
  max-width: 390px;
}

.steps-list {
  display: grid;
  gap: 0;
}

.step {
  display: flex;
  gap: 20px;
  padding: 23px 0;
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.step:first-child {
  padding-top: 0;
}

.step:last-child {
  border-bottom: 0;
}

.step-number {
  color: #a78bfa;
  font-size: 12px;
  font-weight: 750;
  letter-spacing: 1px;
}

.step h3 {
  margin: 0 0 7px;
  font-size: 14px;
}

.step p {
  margin: 0;
  color: #a1a1aa;
  font-size: 12px;
  line-height: 1.7;
}

.bottom-cta {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 105px;
  padding: 45px 20px;
  border: 1px solid rgba(167,139,250,.2);
  border-radius: 18px;
  background: radial-gradient(ellipse at 50% 0%, rgba(124,58,237,.13), transparent 65%), rgba(255,255,255,.018);
  text-align: center;
}

.bottom-cta h2 {
  margin: 19px 0 7px;
  font-size: clamp(25px, 4vw, 35px);
  letter-spacing: -1px;
}

.bottom-cta p {
  margin: 0 0 22px;
  color: #a1a1aa;
  font-size: 13px;
  line-height: 1.8;
}

.footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-top: 70px;
  padding: 24px 0 29px;
  border-top: 1px solid rgba(255,255,255,.08);
}

.footer-brand {
  font-size: 16px;
}

.footer-brand .brand-mark {
  width: 31px;
  height: 31px;
  border-radius: 9px;
}

.footer > p,
.copyright {
  color: #71717a;
  font-size: 10px;
}

.footer-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 10px;
}

@keyframes rise-in {
  from { opacity: 0; transform: translateY(15px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 760px) {
  .navbar,
  .hero,
  .detectors-section,
  .how-section,
  .bottom-cta,
  .footer {
    width: min(100% - 32px, 560px);
  }

  .navbar {
    height: 72px;
  }

  .nav-links {
    position: absolute;
    z-index: 5;
    top: 63px;
    left: 0;
    right: 0;
    display: none;
    flex-direction: column;
    gap: 0;
    padding: 8px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 12px;
    background: #11111b;
  }

  .nav-links.nav-open {
    display: flex;
  }

  .nav-links a {
    padding: 13px;
  }

  .nav-cta {
    margin-left: auto;
    margin-right: 13px;
    padding: 10px;
    font-size: 10px;
  }

  .mobile-menu {
    display: grid;
    place-items: center;
    padding: 5px;
  }

  .hero {
    padding-top: 65px;
  }

  .hero h1 {
    font-size: clamp(39px, 10vw, 59px);
    letter-spacing: -2.5px;
  }

  .hero-description {
    font-size: 13px;
  }

  .hero-visual {
    margin-top: 42px;
  }

  .preview-content {
    padding: 17px 12px;
  }

  .preview-sidebar {
    width: 42px;
  }

  .preview-metrics {
    gap: 7px;
  }

  .metric-card {
    padding: 9px;
    gap: 8px;
  }

  .metric-label {
    font-size: 9px;
  }

  .metric-card strong {
    font-size: 21px;
  }

  .metric-foot {
    font-size: 8px;
  }

  .preview-date {
    display: none;
  }

  .analysis-title {
    flex-wrap: wrap;
  }

  .analysis-bottom {
    align-items: flex-start;
    flex-direction: column;
  }

  .detectors-section {
    padding-top: 80px;
  }

  .detector-grid {
    grid-template-columns: 1fr;
    gap: 13px;
  }

  .detector-card {
    min-height: 240px;
  }

  .how-section {
    grid-template-columns: 1fr;
    gap: 34px;
    padding-top: 90px;
  }

  .bottom-cta {
    margin-top: 75px;
    padding: 36px 17px;
  }

  .footer {
    flex-wrap: wrap;
    justify-content: center;
    text-align: center;
  }

  .footer > p {
    width: 100%;
    order: 3;
    margin: 0;
  }

  .copyright {
    width: 100%;
    order: 4;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}
