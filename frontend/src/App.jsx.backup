import { useState } from 'react'
import {
  ArrowRight,
  ScanSearch,
  FileText,
  Code2,
  Image as ImageIcon,
  Sparkles,
  Zap,
  LockKeyhole,
  Menu,
  X,
  Github,
} from 'lucide-react'
import './App.css'
import CodeEditor from './CodeEditor'

const detectors = [
  {
    id: 'text',
    name: 'Text Detection',
    description: 'Analyze paragraphs, essays, articles, and other written content.',
    icon: FileText,
    accent: 'violet',
    tag: 'NLP powered',
  },
  {
    id: 'code',
    name: 'Code Detection',
    description: 'Inspect source code to identify potentially AI-generated code.',
    icon: Code2,
    accent: 'blue',
    tag: 'Code intelligence',
  },
  {
    id: 'image',
    name: 'Image Detection',
    description: 'Check images for visual patterns associated with AI generation.',
    icon: ImageIcon,
    accent: 'pink',
    tag: 'Vision powered',
  },
]

function App() {
  const [menuOpen, setMenuOpen] = useState(false)
  const [activeDetector, setActiveDetector] = useState(null)
  const [textInput, setTextInput] = useState('')
  const [codeInput, setCodeInput] = useState('')
 const [codeLanguage, setCodeLanguage] = useState('cpp')
  const [imageFile, setImageFile] = useState(null)

  const inputText = activeDetector === 'code' ? codeInput : textInput
  const setInputText = activeDetector === 'code' ? setCodeInput : setTextInput
  const [loading, setLoading] = useState(false)
  const [result, setResult] = useState(null)
  const [error, setError] = useState('')

  async function runDetection(event) {
    event.preventDefault()
    console.log('DETECT CLICKED', { activeDetector, inputLength: inputText.length })
    setLoading(true)
    setResult(null)
    setError('')

    try {
      let response

      if (activeDetector === 'image') {
        if (!imageFile) throw new Error('Please choose an image first.')
        const data = new FormData()
        data.append('file', imageFile)
        response = await fetch('http://127.0.0.1:8000/api/detect/image', {
          method: 'POST',
          body: data,
        })
      } else {
        if (!inputText.trim()) throw new Error('Please enter some content first.')
        const endpoint = activeDetector === 'text' ? 'text' : 'code'
        const payload = activeDetector === 'text'
          ? { text: inputText }
          : { code: inputText }

        response = await fetch(`http://127.0.0.1:8000/api/detect/${endpoint}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        })
      }

      const data = await response.json()
      if (!response.ok) {
        throw new Error(data.detail || `Request failed (${response.status})`)
      }
      setResult(data)
    } catch (err) {
      setError(err.message || 'Detection failed. Check that the backend is running.')
    } finally {
      setLoading(false)
    }
  }

  const scrollToDetectors = () => {
    document.getElementById('detectors')?.scrollIntoView({
      behavior: 'smooth',
    })
    setMenuOpen(false)
  }

  return (
    <div className="app-shell">
      <div className="ambient ambient-one" />
      <div className="ambient ambient-two" />

      <header className="navbar">
        <a className="brand" href="#home" aria-label="VeriScan home">
          <span className="brand-mark">
            <ScanSearch size={23} strokeWidth={2.2} />
          </span>
          <span>Veri<span className="brand-highlight">Scan</span></span>
          <span className="brand-badge">AI</span>
        </a>

        <nav className={`nav-links ${menuOpen ? 'nav-open' : ''}`}>
          <a href="#home" onClick={() => setMenuOpen(false)}>Home</a>
          <a href="#detectors" onClick={() => setMenuOpen(false)}>Detectors</a>
          <a href="#how-it-works" onClick={() => setMenuOpen(false)}>How it works</a>
        </nav>

        <button className="nav-cta" onClick={scrollToDetectors}>
          Start detecting <ArrowRight size={16} />
        </button>

        <button
          className="mobile-menu"
          onClick={() => setMenuOpen(!menuOpen)}
          aria-label="Toggle navigation"
        >
          {menuOpen ? <X size={22} /> : <Menu size={22} />}
        </button>
      </header>

      <main id="home" className={activeDetector ? "workspace-open" : ""}>
      {activeDetector && (
        <>
          <style>{`#home.workspace-open > section:not(.detector-workspace) { display: none !important; }`}</style>
          <section className="detector-workspace" style={{ padding: '48px 24px', maxWidth: '900px', margin: '0 auto', minHeight: '65vh' }}>
            <button className="secondary-button" onClick={() => {
              setActiveDetector(null)
              setResult(null)
              setError('')
            }} style={{ cursor: 'pointer', marginBottom: '24px' }}>
              ← Back to detectors
            </button>

            <h1>{detectors.find((item) => item.id === activeDetector)?.name}</h1>
            <p>{detectors.find((item) => item.id === activeDetector)?.description}</p>

            <form onSubmit={runDetection}>
              {activeDetector === 'image' ? (
                <div className="vs-upload-section">
                  <span className="vs-upload-label">Upload image</span>
                  <label
                    htmlFor="vs-image-upload"
                    className="vs-upload-zone"
                    onDragOver={(e) => e.preventDefault()}
                    onDrop={(e) => {
                      e.preventDefault()
                      const file = e.dataTransfer.files?.[0]
                      if (file?.type.startsWith('image/')) setImageFile(file)
                    }}
                  >
                    {imageFile ? (
                      <div className="vs-image-preview">
                        <img
                          src={URL.createObjectURL(imageFile)}
                          alt="Selected image preview"
                        />
                        <div className="vs-upload-file-info">
                          <strong>{imageFile.name}</strong>
                          <span>{(imageFile.size / 1024).toFixed(1)} KB · Ready to analyze</span>
                          <span className="vs-change-image">Click to change image</span>
                        </div>
                      </div>
                    ) : (
                      <div className="vs-upload-empty">
                        <div className="vs-upload-icon">↑</div>
                        <strong>Drop your image here</strong>
                        <span>or <span className="vs-browse-text">browse files</span></span>
                        <small>PNG, JPG, JPEG or WEBP</small>
                      </div>
                    )}
                    <input
                      id="vs-image-upload"
                      type="file"
                      accept="image/png,image/jpeg,image/webp,image/gif"
                      required={!imageFile}
                      onChange={(e) => setImageFile(e.target.files?.[0] || null)}
                    />
                  </label>
                  {imageFile && (
                    <button
                      type="button"
                      className="vs-remove-image"
                      onClick={() => {
                        setImageFile(null)
                        const input = document.getElementById('vs-image-upload')
                        if (input) input.value = ''
                      }}
                    >
                      Remove image
                    </button>
                  )}
                </div>
              ) : activeDetector === 'code' ? (
                <div style={{ marginTop: '24px' }}>
                  <label htmlFor="code-language" style={{ display: 'block', marginBottom: '8px' }}>
                    Programming language
                  </label>
                  <select
                    id="code-language"
                    value={codeLanguage}
                    onChange={(e) => setCodeLanguage(e.target.value)}
                    style={{ padding: '10px 12px', borderRadius: '8px', marginBottom: '12px', font: 'inherit' }}
                  >
                    <option value="cpp">C++</option>
                    <option value="java">Java</option>
                    <option value="python">Python</option>
                    <option value="javascript">JavaScript</option>
                  </select>
                  <CodeEditor
                    value={codeInput}
                    onChange={setCodeInput}
                    language={codeLanguage}
                  />
                  <input type="text" value={codeInput.trim() ? 'Code entered' : ''} required readOnly
                    tabIndex={-1} aria-label="Code input validation"
                    style={{ position: 'absolute', width: '1px', height: '1px', opacity: 0, pointerEvents: 'none' }}
                  />
                </div>
              ) : (
                <textarea
                  value={textInput}
                  onChange={(e) => setTextInput(e.target.value)}
                  placeholder="Paste the text you want to analyze here..."
                  rows={12}
                  required
                  style={{ display: 'block', width: '100%', marginTop: '24px', padding: '16px', borderRadius: '12px', font: 'inherit' }}
                />
              )}

              <button className="primary-button" type="submit" disabled={loading} style={{ marginTop: '20px' }}>
                {loading ? 'Analyzing...' : 'Detect'}
              </button>
            </form>

            {error && <p role="alert" style={{ color: '#ef4444', marginTop: '20px' }}>{error}</p>}

            {result !== null && (
              <DetectionResult result={result} detector={activeDetector} />
            )}
          </section>
        </>
      )}

        <section className="hero">
          <div className="hero-pill">
            <span className="live-dot" />
            <Sparkles size={14} />
            One platform. Three detection models.
          </div>

          <h1>
            Know what&apos;s real.
            <br />
            <span className="gradient-text">Detect what&apos;s AI.</span>
          </h1>

          <p className="hero-description">
            A unified AI detection workspace for text, source code, and images.
            Analyze content with dedicated machine learning models in one place.
          </p>

          <div className="hero-actions">
            <button className="primary-button" onClick={scrollToDetectors}>
              Explore detectors <ArrowRight size={18} />
            </button>
            <a className="secondary-button" href="#how-it-works">
              <Zap size={17} /> See how it works
            </a>
          </div>

          <div className="hero-trust">
            <div className="avatar-stack" aria-hidden="true">
              <span><FileText size={14} /></span>
              <span><Code2 size={14} /></span>
              <span><ImageIcon size={14} /></span>
            </div>
            <p><strong>3 specialized detectors</strong><br />One streamlined experience</p>
          </div>

          <div className="hero-visual" aria-label="Detection platform preview">
            <div className="preview-topbar">
              <div className="window-dots"><i /><i /><i /></div>
              <span>veriscan / workspace</span>
              <span className="preview-status"><span className="live-dot" /> Ready</span>
            </div>

            <div className="preview-body">
              <aside className="preview-sidebar">
                <div className="mini-logo"><ScanSearch size={19} /></div>
                <div className="mini-side-item active"><FileText size={17} /></div>
                <div className="mini-side-item"><Code2 size={17} /></div>
                <div className="mini-side-item"><ImageIcon size={17} /></div>
                <div className="mini-sidebar-bottom"><LockKeyhole size={16} /></div>
              </aside>

              <div className="preview-content">
                <div className="preview-heading">
                  <div>
                    <span className="eyebrow">YOUR WORKSPACE</span>
                    <h3>Detection overview</h3>
                  </div>
                  <span className="preview-date">All detectors</span>
                </div>

                <div className="preview-metrics">
                  <div className="metric-card">
                    <span className="metric-icon violet"><FileText size={17} /></span>
                    <span className="metric-label">Text analysis</span>
                    <strong>01</strong>
                    <span className="metric-foot">Language model</span>
                  </div>
                  <div className="metric-card">
                    <span className="metric-icon blue"><Code2 size={17} /></span>
                    <span className="metric-label">Code analysis</span>
                    <strong>02</strong>
                    <span className="metric-foot">Code model</span>
                  </div>
                  <div className="metric-card">
                    <span className="metric-icon pink"><ImageIcon size={17} /></span>
                    <span className="metric-label">Image analysis</span>
                    <strong>03</strong>
                    <span className="metric-foot">Vision model</span>
                  </div>
                </div>

                <div className="preview-analysis">
                  <div className="analysis-title">
                    <span>Analysis workspace</span>
                    <span className="analysis-tag"><Sparkles size={12} /> Unified detection</span>
                  </div>
                  <div className="analysis-lines">
                    <span className="line long" />
                    <span className="line medium" />
                    <span className="line short" />
                  </div>
                  <div className="analysis-bottom">
                    <span><LockKeyhole size={13} /> Your content, your analysis</span>
                    <span className="ready-pill">Ready to analyze</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section className="detectors-section" id="detectors">
          <div className="section-heading">
            <span className="eyebrow"><span className="live-dot" /> THE DETECTION SUITE</span>
            <h2>Everything you need to <span className="gradient-text">verify content.</span></h2>
            <p>Choose a detector to get started. Each tool uses its own specialized model.</p>
          </div>

          <div className="detector-grid">
            {detectors.map((detector, index) => {
              const Icon = detector.icon
              return (
                <article
                  className={`detector-card ${detector.accent}`}
                  key={detector.id}
                  style={{ animationDelay: `${index * 100}ms` }}
                >
                  <div className="card-top">
                    <div className={`detector-icon ${detector.accent}`}>
                      <Icon size={24} />
                    </div>
                    <span className="card-number">0{index + 1}</span>
                  </div>
                  <span className="detector-tag">{detector.tag}</span>
                  <h3>{detector.name}</h3>
                  <p>{detector.description}</p>
                  <button
                    className="card-action"
                    onClick={() => {
                      setActiveDetector(detector.id)
                      setMenuOpen(false)
                      window.scrollTo({ top: 0, behavior: 'smooth' })
                    }}
                  >
                    Open detector <ArrowRight size={17} />
                  </button>
                </article>
              )
            })}
          </div>
        </section>

        <section className="how-section" id="how-it-works">
          <div className="how-copy">
            <span className="eyebrow">SIMPLE BY DESIGN</span>
            <h2>From content to insight in <span className="gradient-text">three steps.</span></h2>
            <p>One workspace brings your detection workflow together without unnecessary complexity.</p>
          </div>
          <div className="steps-list">
            <div className="step">
              <span className="step-number">01</span>
              <div><h3>Choose your content type</h3><p>Select text, code, or image detection.</p></div>
            </div>
            <div className="step">
              <span className="step-number">02</span>
              <div><h3>Submit your content</h3><p>Paste text or code, or upload an image.</p></div>
            </div>
            <div className="step">
              <span className="step-number">03</span>
              <div><h3>Review your results</h3><p>See the model prediction and its confidence scores.</p></div>
            </div>
          </div>
        </section>

        <section className="bottom-cta">
          <div className="bottom-cta-icon"><Sparkles size={24} /></div>
          <h2>Ready to take a closer look?</h2>
          <p>Choose your detector and start exploring your content.</p>
          <button className="primary-button" onClick={scrollToDetectors}>
            Get started <ArrowRight size={18} />
          </button>
        </section>
      </main>

      <footer className="footer">
        <a className="brand footer-brand" href="#home">
          <span className="brand-mark"><ScanSearch size={20} /></span>
          <span>Veri<span className="brand-highlight">Scan</span></span>
        </a>
        <p>One workspace for AI content detection.</p>
        <a className="footer-link" href="https://github.com/" target="_blank" rel="noreferrer">
          <Github size={16} /> Built with ML <ArrowRight size={14} />
        </a>
        <span className="copyright">© {new Date().getFullYear()} VeriScan</span>
      </footer>
    </div>
  )
}


function DetectionResult({ result, detector }) {
  const prediction = String(
    result.prediction ?? result.label ?? result.classification ?? "Analysis complete"
  );
  const label = prediction.toLowerCase();
  const isAI = /ai.generated|artificially.generated|synthetic|ai written/.test(label);
  const isHuman = /human.written|human|authentic|real/.test(label);

  const human = Number(
    result.human_probability ?? result.humanProbability ??
    result.human_confidence ?? result.humanConfidence ?? 0
  );
  const ai = Number(
    result.ai_probability ?? result.aiProbability ??
    result.ai_confidence ?? result.aiConfidence ?? 0
  );
  const confidence = Number(
    result.confidence ?? result.model_confidence ?? result.modelConfidence ??
    (isAI ? ai : isHuman ? human : 0)
  );
  const clamp = (n) => Math.max(0, Math.min(100, Number(n) || 0));
  const percent = (n) => `${clamp(n).toFixed(2)}%`;
  const title = detector === "text" ? "Text Detection" :
    detector === "code" ? "Code Detection" : "Image Detection";

  return (
    <section className="vs-result" aria-live="polite">
      <header className="vs-result-head">
        <div>
          <span className="vs-eyebrow">VERISCAN · ANALYSIS REPORT</span>
          <h2>Detection results</h2>
          <p>Analysis completed by your {title.toLowerCase()} model.</p>
        </div>
        <span className="vs-complete"><i /> Complete</span>
      </header>

      <div className={`vs-verdict ${isHuman ? "vs-human" : ""} ${isAI ? "vs-ai" : ""}`}>
        <div className="vs-verdict-icon">{isHuman ? "✓" : isAI ? "!" : "•"}</div>
        <div className="vs-verdict-copy">
          <span>Predicted classification</span>
          <h3>{prediction}</h3>
          <p>Automated model assessment</p>
        </div>
        <div className="vs-confidence">
          <span>Model confidence</span>
          <strong>{percent(confidence)}</strong>
        </div>
      </div>

      {detector === "image" ? (
        <div className="vs-scores">
          {Object.entries(result)
            .filter(([key, value]) =>
              /probability|confidence|score/i.test(key) &&
              value !== null && value !== "" && Number.isFinite(Number(value)))
            .map(([key, value]) => (
              <div className="vs-score vs-image-score" key={key}>
                <span>{key.replace(/_/g, " ")}</span>
                <strong>{percent(value)}</strong>
              </div>
            ))}
        </div>
      ) : (
        <div className="vs-scores">
          <Probability label="Human probability" value={human} type="human" />
          <Probability label="AI probability" value={ai} type="ai" />
        </div>
      )}

      <details className="vs-technical">
        <summary>
          <span>Technical details</span>
          <span>View raw API response ＋</span>
        </summary>
        <pre>{JSON.stringify(result, null, 2)}</pre>
      </details>

      <p className="vs-note">
        <strong>Note:</strong> Model scores are estimates, not definitive proof of authorship.
      </p>
    </section>
  );
}

function Probability({ label, value, type }) {
  const score = Math.max(0, Math.min(100, Number(value) || 0));
  return (
    <div className="vs-score">
      <div className="vs-score-label">
        <span><i className={`vs-dot vs-dot-${type}`} />{label}</span>
        <strong>{score.toFixed(2)}%</strong>
      </div>
      <div className="vs-track" role="progressbar" aria-label={label}
        aria-valuemin={0} aria-valuemax={100} aria-valuenow={score}>
        <div className={`vs-fill vs-fill-${type}`} style={{ width: `${score}%` }} />
      </div>
    </div>
  );
}

export default App
