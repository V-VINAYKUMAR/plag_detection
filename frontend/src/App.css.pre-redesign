#root {
  min-height: 100vh;
}

.app-shell {
  position: relative;
  overflow: hidden;
  background: #09090f;
  color: #f4f4f5;
}

.ambient {
  position: absolute;
  pointer-events: none;
  border-radius: 50%;
  filter: blur(100px);
  opacity: .18;
}

.ambient-one {
  width: 420px;
  height: 420px;
  background: #6d28d9;
  top: 130px;
  left: -250px;
}

.ambient-two {
  width: 480px;
  height: 480px;
  background: #1d4ed8;
  top: 550px;
  right: -300px;
}

.navbar,
.hero,
.detectors-section,
.how-section,
.bottom-cta,
.footer {
  position: relative;
  z-index: 1;
  width: min(1120px, calc(100% - 48px));
  margin-inline: auto;
}

.navbar {
  height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: #f4f4f5;
  text-decoration: none;
  font-size: 20px;
  font-weight: 750;
  letter-spacing: -.7px;
}

.brand-mark,
.bottom-cta-icon {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border: 1px solid rgba(167,139,250,.35);
  border-radius: 12px;
  color: #c4b5fd;
  background: linear-gradient(145deg, rgba(139,92,246,.24), rgba(59,130,246,.1));
}

.brand-highlight {
  color: #a78bfa;
}

.brand-badge {
  padding: 3px 6px;
  border: 1px solid rgba(167,139,250,.35);
  border-radius: 5px;
  color: #c4b5fd;
  font-size: 10px;
  letter-spacing: .4px;
}

.nav-links {
  display: flex;
  gap: 32px;
}

.nav-links a,
.footer-link {
  color: #a1a1aa;
  text-decoration: none;
  font-size: 13px;
  transition: color .2s ease;
}

.nav-links a:hover,
.footer-link:hover {
  color: #c4b5fd;
}

.nav-cta,
.primary-button,
.secondary-button,
.card-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border-radius: 11px;
  cursor: pointer;
  text-decoration: none;
  transition: transform .2s ease, border-color .2s ease, background .2s ease;
}

.nav-cta {
  padding: 11px 15px;
  border: 1px solid rgba(167,139,250,.3);
  color: #e9e5ff;
  background: rgba(139,92,246,.12);
  font-size: 12px;
  font-weight: 650;
}

.nav-cta:hover,
.primary-button:hover,
.secondary-button:hover {
  transform: translateY(-2px);
}

.mobile-menu {
  display: none;
  color: white;
  background: transparent;
  border: 0;
}

.hero {
  padding-top: 86px;
  text-align: center;
}

.hero-pill,
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: #c4b5fd;
  font-size: 11px;
  font-weight: 750;
  letter-spacing: 1.7px;
  text-transform: uppercase;
}

.hero-pill {
  padding: 10px 15px;
  border: 1px solid rgba(167,139,250,.25);
  border-radius: 999px;
  background: rgba(139,92,246,.08);
  font-size: 11px;
  letter-spacing: .2px;
  text-transform: none;
}

.live-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #a78bfa;
  box-shadow: 0 0 12px rgba(167,139,250,.65);
  flex: 0 0 auto;
}

.hero h1 {
  margin: 29px 0 19px;
  font-size: clamp(42px, 7vw, 76px);
  line-height: 1.08;
  letter-spacing: -4px;
  font-weight: 800;
}

.gradient-text {
  background: linear-gradient(100deg, #c4b5fd 5%, #a78bfa 40%, #60a5fa 95%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-description {
  max-width: 610px;
  margin: 0 auto;
  color: #a1a1aa;
  font-size: 15px;
  line-height: 1.9;
}

.hero-actions {
  margin-top: 29px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 13px;
  flex-wrap: wrap;
}

.primary-button {
  min-height: 46px;
  padding: 0 19px;
  border: 1px solid rgba(196,181,253,.45);
  background: linear-gradient(110deg, #7c3aed, #4f46e5);
  color: white;
  box-shadow: 0 8px 30px rgba(109,40,217,.2);
  font-size: 13px;
  font-weight: 700;
}

.secondary-button {
  min-height: 46px;
  padding: 0 17px;
  border: 1px solid rgba(255,255,255,.12);
  color: #d4d4d8;
  background: rgba(255,255,255,.035);
  font-size: 13px;
}

.hero-trust {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12px;
  margin-top: 27px;
  text-align: left;
}

.avatar-stack {
  display: flex;
  padding-left: 4px;
}

.avatar-stack span {
  display: grid;
  place-items: center;
  width: 29px;
  height: 29px;
  margin-left: -4px;
  border: 2px solid #09090f;
  border-radius: 50%;
  color: #ddd6fe;
  background: #292047;
}

.avatar-stack span:nth-child(2) {
  color: #bfdbfe;
  background: #17284b;
}

.avatar-stack span:nth-child(3) {
  color: #fbcfe8;
  background: #4a203f;
}

.hero-trust p {
  margin: 0;
  color: #71717a;
  font-size: 10px;
  line-height: 1.7;
}

.hero-trust strong {
  color: #d4d4d8;
  font-weight: 650;
}

.hero-visual {
  max-width: 860px;
  margin: 58px auto 0;
  overflow: hidden;
  text-align: left;
  border: 1px solid rgba(255,255,255,.13);
  border-radius: 18px;
  background: rgba(15,15,26,.92);
  box-shadow: 0 30px 100px rgba(0,0,0,.4), 0 0 80px rgba(124,58,237,.09);
  animation: rise-in .8s ease both;
}

.preview-topbar {
  display: flex;
  height: 44px;
  align-items: center;
  justify-content: space-between;
  padding: 0 17px;
  border-bottom: 1px solid rgba(255,255,255,.08);
  color: #71717a;
  font-size: 10px;
}

.window-dots {
  display: flex;
  gap: 5px;
}

.window-dots i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #52525b;
}

.window-dots i:first-child { background: #f87171; }
.window-dots i:nth-child(2) { background: #fbbf24; }
.window-dots i:nth-child(3) { background: #4ade80; }

.preview-status,
.preview-analysis .analysis-bottom span,
.analysis-tag {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.preview-status {
  color: #86efac;
}

.preview-status .live-dot {
  width: 6px;
  height: 6px;
  background: #4ade80;
}

.preview-body {
  display: flex;
  min-height: 320px;
}

.preview-sidebar {
  width: 58px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  padding: 18px 0;
  border-right: 1px solid rgba(255,255,255,.07);
  background: rgba(255,255,255,.012);
}

.mini-logo,
.mini-side-item {
  display: grid;
  place-items: center;
  width: 32px;
  height: 32px;
  border-radius: 9px;
}

.mini-logo {
  margin-bottom: 9px;
  color: #c4b5fd;
  background: rgba(139,92,246,.16);
}

.mini-side-item {
  color: #71717a;
}

.mini-side-item.active {
  color: #c4b5fd;
  border: 1px solid rgba(167,139,250,.22);
  background: rgba(139,92,246,.13);
}

.mini-sidebar-bottom {
  margin-top: auto;
  color: #71717a;
}

.preview-content {
  flex: 1;
  min-width: 0;
  padding: 26px;
}

.preview-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.eyebrow {
  font-size: 9px;
  letter-spacing: 1.5px;
}

.preview-heading h3 {
  margin: 8px 0 0;
  font-size: 19px;
  letter-spacing: -.5px;
}

.preview-date {
  padding: 8px 10px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 8px;
  color: #a1a1aa;
  font-size: 10px;
}

.preview-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0,1fr));
  gap: 12px;
  margin-top: 24px;
}

.metric-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
  padding: 14px;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 11px;
  background: rgba(255,255,255,.025);
}

.metric-icon {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  border-radius: 9px;
}

.metric-icon.violet { color: #c4b5fd; background: rgba(139,92,246,.16); }
.metric-icon.blue { color: #93c5fd; background: rgba(59,130,246,.15); }
.metric-icon.pink { color: #f9a8d4; background: rgba(236,72,153,.13); }

.metric-label,
.metric-foot {
  color: #a1a1aa;
  font-size: 10px;
}

.metric-card strong {
  font-size: 25px;
  letter-spacing: -1px;
}

.metric-foot {
  color: #71717a;
  font-size: 9px;
}

.preview-analysis {
  margin-top: 14px;
  padding: 15px;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 11px;
  background: rgba(255,255,255,.02);
}

.analysis-title,
.analysis-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.analysis-title {
  font-size: 11px;
  font-weight: 650;
}

.analysis-tag {
  color: #c4b5fd;
  font-size: 9px;
  font-weight: 500;
}

.analysis-lines {
  display: grid;
  gap: 9px;
  margin: 19px 0;
}

.line {
  display: block;
  height: 6px;
  border-radius: 10px;
  background: linear-gradient(90deg, rgba(167,139,250,.22), rgba(255,255,255,.05));
}

.line.long { width: 86%; }
.line.medium { width: 64%; }
.line.short { width: 43%; }

.analysis-bottom {
  padding-top: 12px;
  border-top: 1px solid rgba(255,255,255,.07);
  color: #71717a;
  font-size: 9px;
}

.ready-pill {
  padding: 5px 8px;
  border: 1px solid rgba(74,222,128,.2);
  border-radius: 6px;
  color: #86efac;
  background: rgba(34,197,94,.07);
}

.detectors-section {
  padding-top: 112px;
  scroll-margin-top: 25px;
}

.section-heading {
  text-align: center;
}

.section-heading h2,
.how-copy h2 {
  margin: 17px 0 12px;
  font-size: clamp(30px, 4vw, 43px);
  line-height: 1.2;
  letter-spacing: -1.8px;
}

.section-heading > p,
.how-copy > p {
  color: #a1a1aa;
  font-size: 13px;
  line-height: 1.8;
}

.detector-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0,1fr));
  gap: 17px;
  margin-top: 39px;
}

.detector-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: 270px;
  padding: 23px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 15px;
  background: linear-gradient(145deg, rgba(255,255,255,.045), rgba(255,255,255,.012));
  transition: transform .25s ease, border-color .25s ease, background .25s ease;
  animation: rise-in .65s ease both;
}

.detector-card::before {
  position: absolute;
  top: -90px;
  right: -90px;
  width: 180px;
  height: 180px;
  border-radius: 50%;
  filter: blur(55px);
  opacity: .12;
  content: "";
  pointer-events: none;
}

.detector-card.violet::before { background: #a78bfa; }
.detector-card.blue::before { background: #60a5fa; }
.detector-card.pink::before { background: #f472b6; }

.detector-card:hover {
  transform: translateY(-5px);
  border-color: rgba(167,139,250,.38);
  background: linear-gradient(145deg, rgba(139,92,246,.09), rgba(255,255,255,.015));
}

.card-top {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
}

.detector-icon {
  display: grid;
  place-items: center;
  width: 47px;
  height: 47px;
  border: 1px solid;
  border-radius: 13px;
}

.detector-icon.violet { color: #c4b5fd; border-color: rgba(167,139,250,.24); background: rgba(139,92,246,.13); }
.detector-icon.blue { color: #93c5fd; border-color: rgba(96,165,250,.24); background: rgba(59,130,246,.12); }
.detector-icon.pink { color: #f9a8d4; border-color: rgba(244,114,182,.24); background: rgba(236,72,153,.1); }

.card-number {
  color: #52525b;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
}

.detector-tag {
  margin-top: 24px;
  color: #a78bfa;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.2px;
  text-transform: uppercase;
}

.detector-card.blue .detector-tag { color: #93c5fd; }
.detector-card.pink .detector-tag { color: #f9a8d4; }

.detector-card h3 {
  margin: 10px 0 8px;
  font-size: 18px;
  letter-spacing: -.4px;
}

.detector-card > p {
  margin: 0;
  color: #a1a1aa;
  font-size: 12px;
  line-height: 1.8;
}

.card-action {
  justify-content: flex-start;
  margin-top: auto;
  padding: 23px 0 0;
  border: 0;
  color: #ddd6fe;
  background: transparent;
  font-size: 11px;
  font-weight: 700;
}

.card-action:hover {
  color: white;
}

.how-section {
  display: grid;
  grid-template-columns: .9fr 1fr;
  align-items: center;
  gap: 80px;
  padding-top: 130px;
  scroll-margin-top: 25px;
}

.how-copy h2 {
  font-size: clamp(31px, 4vw, 42px);
}

.how-copy > p {
  max-width: 390px;
}

.steps-list {
  display: grid;
  gap: 0;
}

.step {
  display: flex;
  gap: 20px;
  padding: 23px 0;
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.step:first-child {
  padding-top: 0;
}

.step:last-child {
  border-bottom: 0;
}

.step-number {
  color: #a78bfa;
  font-size: 12px;
  font-weight: 750;
  letter-spacing: 1px;
}

.step h3 {
  margin: 0 0 7px;
  font-size: 14px;
}

.step p {
  margin: 0;
  color: #a1a1aa;
  font-size: 12px;
  line-height: 1.7;
}

.bottom-cta {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 105px;
  padding: 45px 20px;
  border: 1px solid rgba(167,139,250,.2);
  border-radius: 18px;
  background: radial-gradient(ellipse at 50% 0%, rgba(124,58,237,.13), transparent 65%), rgba(255,255,255,.018);
  text-align: center;
}

.bottom-cta h2 {
  margin: 19px 0 7px;
  font-size: clamp(25px, 4vw, 35px);
  letter-spacing: -1px;
}

.bottom-cta p {
  margin: 0 0 22px;
  color: #a1a1aa;
  font-size: 13px;
  line-height: 1.8;
}

.footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-top: 70px;
  padding: 24px 0 29px;
  border-top: 1px solid rgba(255,255,255,.08);
}

.footer-brand {
  font-size: 16px;
}

.footer-brand .brand-mark {
  width: 31px;
  height: 31px;
  border-radius: 9px;
}

.footer > p,
.copyright {
  color: #71717a;
  font-size: 10px;
}

.footer-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 10px;
}

@keyframes rise-in {
  from { opacity: 0; transform: translateY(15px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 760px) {
  .navbar,
  .hero,
  .detectors-section,
  .how-section,
  .bottom-cta,
  .footer {
    width: min(100% - 32px, 560px);
  }

  .navbar {
    height: 72px;
  }

  .nav-links {
    position: absolute;
    z-index: 5;
    top: 63px;
    left: 0;
    right: 0;
    display: none;
    flex-direction: column;
    gap: 0;
    padding: 8px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 12px;
    background: #11111b;
  }

  .nav-links.nav-open {
    display: flex;
  }

  .nav-links a {
    padding: 13px;
  }

  .nav-cta {
    margin-left: auto;
    margin-right: 13px;
    padding: 10px;
    font-size: 10px;
  }

  .mobile-menu {
    display: grid;
    place-items: center;
    padding: 5px;
  }

  .hero {
    padding-top: 65px;
  }

  .hero h1 {
    font-size: clamp(39px, 10vw, 59px);
    letter-spacing: -2.5px;
  }

  .hero-description {
    font-size: 13px;
  }

  .hero-visual {
    margin-top: 42px;
  }

  .preview-content {
    padding: 17px 12px;
  }

  .preview-sidebar {
    width: 42px;
  }

  .preview-metrics {
    gap: 7px;
  }

  .metric-card {
    padding: 9px;
    gap: 8px;
  }

  .metric-label {
    font-size: 9px;
  }

  .metric-card strong {
    font-size: 21px;
  }

  .metric-foot {
    font-size: 8px;
  }

  .preview-date {
    display: none;
  }

  .analysis-title {
    flex-wrap: wrap;
  }

  .analysis-bottom {
    align-items: flex-start;
    flex-direction: column;
  }

  .detectors-section {
    padding-top: 80px;
  }

  .detector-grid {
    grid-template-columns: 1fr;
    gap: 13px;
  }

  .detector-card {
    min-height: 240px;
  }

  .how-section {
    grid-template-columns: 1fr;
    gap: 34px;
    padding-top: 90px;
  }

  .bottom-cta {
    margin-top: 75px;
    padding: 36px 17px;
  }

  .footer {
    flex-wrap: wrap;
    justify-content: center;
    text-align: center;
  }

  .footer > p {
    width: 100%;
    order: 3;
    margin: 0;
  }

  .copyright {
    width: 100%;
    order: 4;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}


/* ===== VeriScan detection results dashboard ===== */
.vs-result {
  margin-top: 30px; padding: clamp(18px, 4vw, 30px);
  color: #f4f4f5; background: linear-gradient(145deg, #181821, #101016);
  border: 1px solid rgba(167,139,250,.22); border-radius: 22px;
  box-shadow: 0 22px 60px rgba(0,0,0,.22);
  animation: vs-appear .35s ease-out;
}
.vs-result * { box-sizing: border-box; }
.vs-result-head { display:flex; justify-content:space-between; align-items:flex-start; gap:16px; margin-bottom:24px; }
.vs-eyebrow { color:#a78bfa; font-size:10px; font-weight:800; letter-spacing:1.6px; }
.vs-result-head h2 { margin:9px 0 7px; font-size:clamp(23px,4vw,30px); letter-spacing:-.8px; }
.vs-result-head p,.vs-verdict-copy p { margin:0; color:#a1a1aa; font-size:13px; line-height:1.65; }
.vs-complete { display:inline-flex; align-items:center; gap:7px; flex-shrink:0; padding:8px 11px; color:#6ee7b7; background:rgba(16,185,129,.08); border:1px solid rgba(52,211,153,.22); border-radius:30px; font-size:11px; }
.vs-complete i { width:7px; height:7px; background:#34d399; border-radius:50%; }
.vs-verdict { display:flex; align-items:center; gap:16px; padding:22px; border:1px solid rgba(167,139,250,.24); border-radius:16px; background:rgba(139,92,246,.07); }
.vs-verdict.vs-human { border-color:rgba(52,211,153,.28); background:rgba(16,185,129,.07); }
.vs-verdict.vs-ai { border-color:rgba(248,113,113,.3); background:rgba(239,68,68,.07); }
.vs-verdict-icon { display:grid; place-items:center; flex-shrink:0; width:46px; height:46px; border-radius:14px; background:rgba(167,139,250,.14); color:#c4b5fd; font-size:25px; font-weight:800; }
.vs-human .vs-verdict-icon { color:#6ee7b7; background:rgba(52,211,153,.12); }
.vs-ai .vs-verdict-icon { color:#fca5a5; background:rgba(248,113,113,.12); }
.vs-verdict-copy { flex:1; min-width:0; }
.vs-verdict-copy>span,.vs-confidence>span { color:#a1a1aa; font-size:11px; }
.vs-verdict-copy h3 { margin:6px 0 7px; font-size:clamp(19px,3vw,25px); overflow-wrap:anywhere; }
.vs-human .vs-verdict-copy h3 { color:#6ee7b7; }
.vs-ai .vs-verdict-copy h3 { color:#fca5a5; }
.vs-confidence { display:flex; flex-direction:column; gap:7px; flex-shrink:0; text-align:right; }
.vs-confidence strong { font-size:24px; letter-spacing:-.7px; font-variant-numeric:tabular-nums; }
.vs-scores { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:15px; margin-top:17px; }
.vs-score { min-width:0; padding:18px; background:rgba(255,255,255,.025); border:1px solid rgba(148,163,184,.16); border-radius:14px; }
.vs-score-label { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:14px; }
.vs-score-label>span { display:flex; align-items:center; gap:8px; color:#d4d4d8; font-size:12px; }
.vs-score-label strong,.vs-image-score strong { font-size:18px; font-variant-numeric:tabular-nums; }
.vs-dot { width:8px; height:8px; flex-shrink:0; border-radius:50%; }
.vs-dot-human { background:#34d399; } .vs-dot-ai { background:#f87171; }
.vs-track { height:7px; overflow:hidden; border-radius:9px; background:#30303a; }
.vs-fill { height:100%; border-radius:inherit; transition:width .5s ease; }
.vs-fill-human { background:linear-gradient(90deg,#059669,#6ee7b7); }
.vs-fill-ai { background:linear-gradient(90deg,#dc2626,#fca5a5); }
.vs-image-score { display:flex; justify-content:space-between; align-items:center; gap:10px; }
.vs-image-score>span { color:#d4d4d8; text-transform:capitalize; overflow-wrap:anywhere; }
.vs-technical { margin-top:18px; border:1px solid rgba(148,163,184,.17); border-radius:13px; background:rgba(255,255,255,.02); }
.vs-technical summary { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:16px; cursor:pointer; font-size:12px; font-weight:650; list-style:none; }
.vs-technical summary::-webkit-details-marker { display:none; }
.vs-technical summary span:last-child { color:#a78bfa; font-weight:500; }
.vs-technical pre { max-height:300px; overflow:auto; margin:0; padding:17px; border-top:1px solid rgba(148,163,184,.15); color:#c4b5fd; font-size:12px; line-height:1.7; white-space:pre-wrap; overflow-wrap:anywhere; }
.vs-note { margin:16px 0 0; color:#a1a1aa; font-size:11px; line-height:1.7; }
.vs-note strong { color:#d4d4d8; }
@keyframes vs-appear { from { opacity:0; transform:translateY(7px); } to { opacity:1; transform:translateY(0); } }
@media(max-width:600px) {
  .vs-result-head { flex-direction:column; }
  .vs-verdict { flex-wrap:wrap; padding:16px; }
  .vs-confidence { width:100%; text-align:left; }
  .vs-scores { grid-template-columns:1fr; }
  .vs-score { padding:15px; }
}


/* ===== VeriScan editorial UI refresh ===== */
:root {
  --vs-bg: #101312;
  --vs-panel: #171b19;
  --vs-border: #303833;
  --vs-muted: #a3ada6;
  --vs-accent: #a3e6bd;
  --vs-text: #edf2ee;
}

html { scroll-behavior: smooth; }

body {
  background: var(--vs-bg);
  color: var(--vs-text);
}

.app-shell {
  background: var(--vs-bg);
  color: var(--vs-text);
}

.ambient {
  opacity: .12;
  filter: blur(110px);
  pointer-events: none;
}

.navbar {
  background: rgba(16, 19, 18, .94);
  border-bottom: 1px solid var(--vs-border);
  backdrop-filter: blur(16px);
}

.brand {
  gap: 10px;
  font-weight: 750;
  letter-spacing: -.6px;
}

.brand-mark {
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: #d8f3e1;
  color: #153a28;
  box-shadow: none;
}

.brand-highlight {
  color: var(--vs-accent);
}

.brand-badge {
  border: 1px solid #3a4c41;
  background: #202a24;
  color: #b9d9c4;
}

.nav-links a {
  color: #b8c1ba;
  transition: color .18s ease;
}

.nav-links a:hover,
.footer-link:hover {
  color: var(--vs-accent);
}

.primary-button,
.nav-cta {
  background: var(--vs-accent);
  color: #14281d;
  border: 1px solid var(--vs-accent);
  box-shadow: none;
  font-weight: 700;
}

.primary-button:hover,
.nav-cta:hover {
  background: #c1efd1;
  color: #14281d;
  transform: translateY(-1px);
  box-shadow: none;
}

.secondary-button {
  background: transparent;
  border: 1px solid #414b44;
  color: var(--vs-text);
  box-shadow: none;
}

.secondary-button:hover {
  background: #1c2420;
  border-color: #718a78;
}

.hero {
  padding-top: clamp(60px, 9vw, 110px);
  padding-bottom: clamp(60px, 8vw, 100px);
}

.hero-pill {
  background: #1a241e;
  border: 1px solid #35493a;
  color: #c3e4cd;
  box-shadow: none;
}

.hero h1 {
  letter-spacing: -2.5px;
  line-height: 1.04;
}

.gradient-text {
  background: none;
  color: var(--vs-accent);
  -webkit-text-fill-color: var(--vs-accent);
}

.hero-description,
.section-heading p,
.how-copy p {
  color: #aab4ac;
  line-height: 1.8;
}

.hero-visual {
  background: #171b19;
  border: 1px solid var(--vs-border);
  border-radius: 15px;
  box-shadow: 0 24px 65px rgba(0, 0, 0, .2);
}

.preview-topbar {
  background: #1b201d;
  border-bottom: 1px solid var(--vs-border);
}

.preview-sidebar {
  background: #131714;
  border-right: 1px solid var(--vs-border);
}

.mini-logo {
  color: var(--vs-accent);
}

.mini-side-item.active {
  background: #273b2d;
  color: var(--vs-accent);
}

.metric-card,
.preview-analysis {
  background: #1b201d;
  border: 1px solid var(--vs-border);
  border-radius: 12px;
  box-shadow: none;
}

.metric-icon.violet,
.metric-icon.blue,
.metric-icon.pink {
  background: #26362b;
  color: var(--vs-accent);
}

.section-heading h2,
.how-copy h2 {
  letter-spacing: -1.2px;
}

.detector-card {
  background: #171b19;
  border: 1px solid var(--vs-border);
  border-radius: 15px;
  box-shadow: none;
  transition: border-color .2s ease, transform .2s ease;
}

.detector-card:hover {
  transform: translateY(-3px);
  border-color: #6b8b74;
  box-shadow: none;
}

.detector-card::before {
  display: none;
}

.detector-icon.violet,
.detector-icon.blue,
.detector-icon.pink {
  background: #26362b;
  color: var(--vs-accent);
  box-shadow: none;
}

.detector-tag,
.card-number {
  color: #b2c7b7;
}

.card-action {
  color: var(--vs-accent);
}

.steps-list .step {
  border-bottom-color: var(--vs-border);
}

.step-number {
  color: var(--vs-accent);
}

.bottom-cta {
  background: #171d19;
  border: 1px solid var(--vs-border);
  border-radius: 18px;
  box-shadow: none;
}

.bottom-cta-icon {
  background: #273b2d;
  color: var(--vs-accent);
}

.footer {
  border-top: 1px solid var(--vs-border);
  color: #a3ada6;
}

.footer .brand-mark {
  background: #d8f3e1;
  color: #153a28;
}

.footer-brand .brand-highlight {
  color: var(--vs-accent);
}

.result-panel,
.vs-result {
  box-shadow: none;
}

@media (max-width: 600px) {
  .hero h1 {
    letter-spacing: -1.5px;
  }

  .hero-visual {
    border-radius: 12px;
  }

  .detector-card:hover {
    transform: none;
  }
}



/* VeriScan image upload */
.vs-upload-section { margin-top: 28px; width: 100%; text-align: left; }
.vs-upload-label { display: block; margin-bottom: 12px; font-size: 14px; font-weight: 600; color: #e5e7eb; }
.vs-upload-zone {
  display: flex; width: 100%; min-height: 230px; box-sizing: border-box;
  align-items: center; justify-content: center; overflow: hidden;
  border: 1.5px dashed #454b54; border-radius: 16px;
  background: #151816; cursor: pointer;
  transition: border-color 180ms ease, background 180ms ease;
}
.vs-upload-zone:hover { border-color: #9ce5bc; background: #191f1b; }
.vs-upload-zone input[type="file"] { display: none !important; }
.vs-upload-empty {
  display: flex; align-items: center; justify-content: center;
  flex-direction: column; gap: 9px; padding: 28px 16px; text-align: center;
}
.vs-upload-icon {
  display: grid; place-items: center; width: 48px; height: 48px;
  margin-bottom: 5px; border: 1px solid #344a3c; border-radius: 14px;
  background: #1d2b22; color: #a2e8bd; font-size: 27px;
}
.vs-upload-empty strong { color: #f3f4f6; font-size: 16px; }
.vs-upload-empty > span { color: #a1a1aa; font-size: 14px; }
.vs-browse-text, .vs-change-image { color: #a2e8bd !important; font-weight: 600; }
.vs-upload-empty small { margin-top: 6px; color: #777f79; font-size: 12px; }
.vs-image-preview {
  display: flex; align-items: center; gap: 20px; width: 100%;
  padding: 18px; box-sizing: border-box;
}
.vs-image-preview img {
  display: block; width: 150px; height: 150px; flex-shrink: 0;
  object-fit: contain; border-radius: 10px; background: #0d0f0e;
}
.vs-upload-file-info {
  display: flex; min-width: 0; flex-direction: column;
  align-items: flex-start; gap: 9px;
}
.vs-upload-file-info strong { max-width: 100%; overflow-wrap: anywhere; color: #f3f4f6; font-size: 14px; }
.vs-upload-file-info span { color: #a1a1aa; font-size: 13px; }
.vs-upload-file-info .vs-change-image { margin-top: 5px; }
.vs-remove-image {
  display: block; margin-top: 10px; padding: 7px 0; border: 0;
  background: transparent; color: #fca5a5; cursor: pointer;
  font: inherit; font-size: 13px;
}
@media (max-width: 560px) {
  .vs-upload-zone { min-height: 200px; }
  .vs-image-preview { flex-direction: column; align-items: flex-start; }
  .vs-image-preview img { width: 100%; height: 180px; }
}

/* ===== VeriScan premium motion upgrade ===== */

:root {
  --vs-glow: rgba(121, 237, 169, 0.18);
  --vs-glow-strong: rgba(121, 237, 169, 0.32);
}

/* Rich ambient lighting */
.app-shell {
  isolation: isolate;
  background:
    radial-gradient(ellipse at 50% -15%, rgba(83, 151, 105, 0.12), transparent 52%),
    var(--vs-bg, #101312);
}

.ambient {
  will-change: transform;
  animation: vs-ambient-drift 18s ease-in-out infinite alternate;
}

.ambient-one {
  background: #39c878;
  opacity: 0.14;
}

.ambient-two {
  background: #2f8f70;
  opacity: 0.12;
  animation-delay: -8s;
}

@keyframes vs-ambient-drift {
  0% { transform: translate3d(0, 0, 0) scale(1); }
  50% { transform: translate3d(35px, -24px, 0) scale(1.08); }
  100% { transform: translate3d(-18px, 32px, 0) scale(.96); }
}

/* Refined navigation */
.navbar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(16, 19, 18, 0.82);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.brand-mark {
  transition: transform .3s ease, box-shadow .3s ease;
}

.brand:hover .brand-mark {
  transform: rotate(-5deg) scale(1.06);
  box-shadow: 0 0 24px var(--vs-glow);
}

.nav-links a {
  position: relative;
}

.nav-links a::after {
  position: absolute;
  right: 0;
  bottom: -7px;
  left: 0;
  height: 2px;
  content: "";
  background: var(--vs-accent, #a3e6bd);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .25s ease;
}

.nav-links a:hover::after {
  transform: scaleX(1);
}

/* Hero entrance */
.hero-pill {
  animation: vs-fade-up .7s .05s both;
}

.hero h1 {
  animation: vs-fade-up .75s .12s both;
}

.hero-description {
  animation: vs-fade-up .75s .22s both;
}

.hero-actions {
  animation: vs-fade-up .75s .32s both;
}

.hero-trust {
  animation: vs-fade-up .75s .4s both;
}

.hero-visual {
  border-color: rgba(163, 230, 189, 0.2);
  box-shadow:
    0 28px 90px rgba(0, 0, 0, 0.3),
    0 0 60px rgba(90, 200, 133, 0.045);
  transition: border-color .3s ease, box-shadow .3s ease;
}

.hero-visual:hover {
  border-color: rgba(163, 230, 189, 0.35);
  box-shadow:
    0 32px 95px rgba(0, 0, 0, 0.36),
    0 0 70px rgba(90, 200, 133, 0.09);
}

@keyframes vs-fade-up {
  from { opacity: 0; transform: translateY(18px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Premium detector cards */
.detector-card {
  isolation: isolate;
  border-color: rgba(163, 230, 189, 0.13);
  background: linear-gradient(
    145deg,
    rgba(255, 255, 255, 0.045),
    rgba(255, 255, 255, 0.012)
  );
}

.detector-card::before {
  display: block;
  background: #68e5a0;
  opacity: 0;
  transition: opacity .35s ease;
}

.detector-card:hover {
  transform: translateY(-7px);
  border-color: rgba(163, 230, 189, 0.42);
  background: linear-gradient(
    145deg,
    rgba(86, 180, 119, 0.105),
    rgba(255, 255, 255, 0.018)
  );
  box-shadow: 0 18px 48px rgba(0, 0, 0, 0.2);
}

.detector-card:hover::before {
  opacity: .15;
}

.detector-icon {
  transition: transform .3s ease, box-shadow .3s ease;
}

.detector-card:hover .detector-icon {
  transform: translateY(-3px) scale(1.045);
  box-shadow: 0 0 22px var(--vs-glow);
}

.card-action svg {
  transition: transform .25s ease;
}

.card-action:hover svg {
  transform: translateX(5px);
}

/* Buttons feel responsive */
.primary-button,
.secondary-button,
.nav-cta,
.card-action {
  transition:
    transform .22s ease,
    background .22s ease,
    border-color .22s ease,
    box-shadow .22s ease;
}

.primary-button:hover,
.nav-cta:hover {
  box-shadow: 0 0 25px var(--vs-glow);
}

.primary-button:active,
.secondary-button:active,
.nav-cta:active {
  transform: scale(.98);
}

button:focus-visible,
a:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 2px solid var(--vs-accent, #a3e6bd);
  outline-offset: 4px;
}

/* Detector workspace */
.detector-workspace {
  animation: vs-fade-up .45s ease both;
}

.detector-workspace h1 {
  letter-spacing: -1.4px;
}

.detector-workspace form textarea,
.detector-workspace form select {
  border: 1px solid var(--vs-border, #303833);
  background-color: #151a17;
  color: var(--vs-text, #edf2ee);
  transition: border-color .2s ease, box-shadow .2s ease;
}

.detector-workspace form textarea:focus,
.detector-workspace form select:focus {
  border-color: rgba(163, 230, 189, .65);
  box-shadow: 0 0 0 4px rgba(163, 230, 189, .07);
  outline: none;
}

.vs-upload-zone {
  position: relative;
  border-color: #46584b;
  background:
    radial-gradient(ellipse at 50% 0%, rgba(100, 210, 143, .055), transparent 65%),
    #151816;
  transition:
    border-color .25s ease,
    background .25s ease,
    box-shadow .25s ease,
    transform .25s ease;
}

.vs-upload-zone:hover {
  transform: translateY(-2px);
  border-color: var(--vs-accent, #a3e6bd);
  box-shadow: 0 0 28px rgba(121, 237, 169, .07);
}

.vs-upload-icon {
  animation: vs-icon-float 3s ease-in-out infinite;
}

@keyframes vs-icon-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4px); }
}

/* Scanning feedback when detection is running */
.primary-button:disabled {
  cursor: wait;
  opacity: .78;
  animation: vs-button-pulse 1.4s ease-in-out infinite;
}

@keyframes vs-button-pulse {
  0%, 100% { box-shadow: 0 0 0 rgba(121, 237, 169, 0); }
  50% { box-shadow: 0 0 22px rgba(121, 237, 169, .2); }
}

/* Results enter smoothly */
.vs-result {
  border-color: rgba(163, 230, 189, .2);
  animation: vs-result-enter .55s cubic-bezier(.2, .75, .25, 1) both;
}

.vs-fill {
  transform-origin: left;
  animation: vs-bar-enter .85s .12s cubic-bezier(.2, .75, .25, 1) both;
}

@keyframes vs-result-enter {
  from { opacity: 0; transform: translateY(16px) scale(.99); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes vs-bar-enter {
  from { transform: scaleX(.15); }
  to { transform: scaleX(1); }
}

/* Respect accessibility preferences */
@media (prefers-reduced-motion: reduce) {
  .ambient,
  .hero-pill,
  .hero h1,
  .hero-description,
  .hero-actions,
  .hero-trust,
  .hero-visual,
  .detector-card,
  .detector-workspace,
  .vs-result,
  .vs-fill,
  .vs-upload-icon,
  .primary-button:disabled {
    animation: none !important;
  }

  .detector-card:hover,
  .vs-upload-zone:hover {
    transform: none;
  }
}

@media (max-width: 600px) {
  .detector-card:hover {
    transform: translateY(-2px);
  }

  .hero h1 {
    overflow-wrap: anywhere;
  }

  .detector-workspace {
    padding-right: 16px !important;
    padding-left: 16px !important;
  }
}
